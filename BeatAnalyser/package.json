{
  "name": "beat-analyser",
  "version": "1.0.0",
  "description": "BeatAnalyser — Adobe Premiere Pro CEP panel for BPM and musical key detection",
  "private": true,
  "scripts": {
    "postinstall":     "node scripts/copyWasm.js",
    "download-wasm":   "node scripts/downloadWasm.js",
    "dev":             "npm run download-wasm && node scripts/installDev.js",
    "build":           "node scripts/buildDist.js",
    "build:clean":     "node scripts/buildDist.js --clean",
    "package":         "npm run build:clean && node scripts/packageZxp.js",
    "lint":            "eslint js/**/*.js",
    "validate-manifest": "node scripts/validateManifest.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "aubiojs": "^0.1.3",
    "essentia.js": "^0.1.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "cep": {
    "extensionId": "com.beatanalyser.panel",
    "hostApp": "PPRO",
    "minHostVersion": "15.0",
    "panelWidth": 380,
    "panelHeight": 600
  },
  "keywords": [
    "adobe-premiere",
    "cep",
    "beat-detection",
    "bpm",
    "key-detection",
    "aubio",
    "essentia",
    "wasm"
  ],
  "license": "MIT"
}
